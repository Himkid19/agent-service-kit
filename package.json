    "test:watch": "vitest",
    "setup": "npm ci",
    "cli": "tsx scripts/chat-cli.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
