    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.23.0",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/swagger-ui-express": "^4.1.8",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
