{
  "name": "agent-service-kit",
  "version": "0.1.0",
  "description": "A production-ready, self-hosted framework for deploying configurable LLM agent services with isolated workspaces, persistent conversations, tools, and streaming APIs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Himkid19/agent-service-kit.git"
  },
  "bugs": {
    "url": "https://github.com/Himkid19/agent-service-kit/issues"
  },
  "homepage": "https://github.com/Himkid19/agent-service-kit#readme",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
