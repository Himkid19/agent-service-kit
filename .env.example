# Server
PORT=3001
HOST=0.0.0.0

# Required in production. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-bytes

# Optional bootstrap admin password. If omitted, a strong password is generated
# once and printed in the startup log.
# ADMIN_INITIAL_PASSWORD=

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-your-database-password
DB_NAME=agent_service_kit

# Default OpenAI-compatible provider. These values are optional when a provider
# has already been registered through the HTTP API.
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-4o
PROVIDER_NAME=openai
PROVIDER_BASE_URL=https://api.openai.com/v1
PROVIDER_API_KEY=replace-with-your-api-key

# Optional gateway tracing headers
# LLM_TRACE_IDENTIFIER=
# LLM_TRACE_IDENTIFIER_TYPE=

# Runtime limits
MAX_CONCURRENT_LLM_CALLS=2
LLM_QUEUE_TIMEOUT_MS=300000
SESSION_IDLE_TTL_MS=1800000
SESSION_CACHE_CAPACITY=20
SESSION_SWEEP_INTERVAL_MS=300000
STREAM_TIMEOUT_MS=300000

# Logging and persistence resilience
LOG_LEVEL=info
DB_CONNECT_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=15000
DB_IDLE_TIMEOUT_MS=60000
DB_CONNECTION_LIMIT=10
HEARTBEAT_INTERVAL_MS=30000
SLOW_QUERY_MS=500
